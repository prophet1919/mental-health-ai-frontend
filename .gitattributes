# 统一行尾，避免 Windows 开发 / 跨平台克隆时产生整文件 diff
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary

# 锁文件在 diff 中折叠
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
